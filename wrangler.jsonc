/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * NOTE: The `main` field is intentionally omitted. The Astro Cloudflare
 * adapter (@astrojs/cloudflare) sets its own worker entrypoint during build.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ispiroglu",
	"compatibility_date": "2025-04-04",
	"vars": {},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "VIEWS_KV",
			"id": "fe4f30d2bc444ed6b5699a6fdcad7c0d"
		}
	]
}
