---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BookmarksCategoryPage, categoryBookmarks } from "../../components/pages/bookmarks-category-page";

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(categoryBookmarks).map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const title = `EI-01 — ${(category ?? "BOOKMARKS").toUpperCase()}`;
const description = `${(category ?? "BOOKMARKS").toUpperCase()} bookmarks and resources.`;
---

<BaseLayout title={title} description={description}>
  <BookmarksCategoryPage client:load category={category ?? "unknown"} />
</BaseLayout>
