{
	"name": "ispiroglu-astro",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node scripts/generate-posts.js && node scripts/generate-stack.js && astro build",
		"cf-typegen": "wrangler types",
		"deploy": "bun run build && wrangler deploy",
		"dev": "astro dev",
		"dev:worker": "bun run build && wrangler dev --config dist/server/wrangler.json --port 8787 --local",
		"postinstall": "npm run cf-typegen",
		"preview": "astro preview",
		"typecheck": "wrangler types && astro check",
		"generate-posts": "node scripts/generate-posts.js",
		"generate-stack": "node scripts/generate-stack.js"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"gray-matter": "^4.0.3",
		"lucide-react": "^0.548.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"reading-time": "^1.5.0",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.4",
		"@astrojs/cloudflare": "^14.2.0",
		"@astrojs/react": "^6.0.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.13",
		"@types/node": "^22",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"astro": "^7.2.0",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"wrangler": "^4.45.3"
	}
}
