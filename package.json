{
	"name": "my-react-router-app",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node scripts/generate-posts.js && node scripts/generate-stack.js && react-router build",
		"cf-typegen": "wrangler types",
		"deploy": "bun run build && wrangler deploy",
		"dev": "react-router dev",
		"postinstall": "npm run cf-typegen",
		"preview": "bun run build && vite preview",
		"typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
		"generate-posts": "node scripts/generate-posts.js",
		"generate-stack": "node scripts/generate-stack.js"
	},
	"dependencies": {
		"@mdx-js/rollup": "^3.1.1",
		"@radix-ui/react-progress": "^1.1.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"gray-matter": "^4.0.3",
		"isbot": "^5.1.31",
		"lucide-react": "^0.548.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-router": "^7.9.2",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-pretty-code": "^0.14.1",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^3.14.0",
		"tailwind-merge": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
